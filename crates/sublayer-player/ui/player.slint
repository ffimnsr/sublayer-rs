import { Button, CheckBox, ComboBox, HorizontalBox, Slider, VerticalBox } from "std-widgets.slint";

export component PlayerWindow inherits Window {
    title: "Sublayer Player";
    preferred-width: 1100px;
    preferred-height: 720px;

    in property <string> file_title: "sublayer-player — no video open";
    in property <string> status: "";
    in property <string> time_label: "0:00 / 0:00";
    in property <string> caption_text: "";
    in property <string> detected_label: "";

    in property <bool> playing: false;
    in property <bool> can_seek: false;
    in property <bool> muted: false;
    in property <bool> translate_enabled: false;

    in property <int> playhead_ms: 0;
    in property <int> duration_ms: 0;
    in property <float> volume: 100;
    in property <image> frame;

    in property <[string]> models: [];
    in property <[string]> languages: [];
    in property <int> model_index: 0;
    in property <int> language_index: 0;

    callback open_clicked();
    callback pre_transcribe_clicked();
    callback play_toggled();
    callback stop_clicked();
    callback seek_by(int);
    /// Slider still being dragged: only the display follows the knob.
    callback scrub(int);
    /// Slider released (or seek committed): the decoders restart here.
    callback seek(int);
    callback volume_changed(float);
    callback mute_toggled();
    callback fullscreen_toggled();
    callback escape_fullscreen();
    callback translate_toggled(bool);
    callback model_selected(string);
    callback language_selected(string);

    forward-focus: key-scope;
    key-scope := FocusScope {
        // Fill the window so the layout inside behaves like a root layout;
        // a plain item would otherwise shrink to its preferred size.
        width: 100%;
        height: 100%;
        // Standard media-player shortcuts. Unhandled keys bubble up from
        // focused controls, so these keep working after any button is
        // clicked.
        key-pressed(event) => {
            if (event.text == Key.Space) { root.play_toggled(); accept }
            else if (event.text == Key.LeftArrow) { root.seek_by(-5000); accept }
            else if (event.text == Key.RightArrow) { root.seek_by(5000); accept }
            else if (event.text == Key.UpArrow) { root.volume_changed(Math.min(150, root.volume + 10)); accept }
            else if (event.text == Key.DownArrow) { root.volume_changed(Math.max(0, root.volume - 10)); accept }
            else if (event.text == Key.M) { root.mute_toggled(); accept }
            else if (event.text == Key.F) { root.fullscreen_toggled(); accept }
            else if (event.text == Key.Escape) { root.escape_fullscreen(); accept }
            else { reject }
        }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.file_title;
                font-size: 15px;
                vertical-alignment: center;
            }
            Rectangle { width: 4px; }
            Button { text: "Open…"; clicked => { root.open_clicked(); } }
            Button {
                text: "Pre-transcribe";
                enabled: root.can_seek;
                clicked => { root.pre_transcribe_clicked(); }
            }
            ComboBox {
                model: root.models;
                current-index: root.model_index;
                selected(text) => { root.model_selected(text); }
            }
            ComboBox {
                model: root.languages;
                current-index: root.language_index;
                selected(text) => { root.language_selected(text); }
            }
            CheckBox {
                text: "Translate to English";
                checked: root.translate_enabled;
                toggled() => { root.translate_toggled(self.checked); }
            }
            Text {
                text: root.detected_label;
                font-size: 13px;
                color: #9ca3af;
                vertical-alignment: center;
            }
        }

        // Video area with the caption overlay. Clicking the picture
        // toggles play/pause like any self-respecting media player.
        Rectangle {
            background: black;
            vertical-stretch: 1;
            min-height: 240px;
            TouchArea {
                clicked => { root.play_toggled(); }
            }
            Image {
                source: root.frame;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }
            Rectangle {
                visible: root.caption_text != "";
                x: 24px;
                width: parent.width - 48px;
                y: parent.height - 96px;
                height: 68px;
                background: rgba(0, 0, 0, 170);
                border-radius: 10px;
                Text {
                    text: root.caption_text;
                    x: 12px;
                    width: parent.width - 24px;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    font-size: 24px;
                    font-weight: 600;
                    color: white;
                }
            }
        }

        Text {
            text: root.status;
            font-size: 12px;
            color: #9ca3af;
            height: 16px;
        }

        HorizontalLayout {
            spacing: 8px;
            // Icon-only transport; every button is mirrored by a keyboard
            // shortcut (Space, ←/→, M, F) in the key scope above. Fixed
            // widths keep the row from shifting when icons toggle.
            Button {
                text: "⏪";
                width: 44px;
                enabled: root.can_seek;
                clicked => { root.seek_by(-5000); }
            }
            Button {
                text: root.playing ? "⏸" : "⏵";
                width: 44px;
                enabled: root.can_seek;
                clicked => { root.play_toggled(); }
            }
            Button {
                text: "⏹";
                width: 44px;
                enabled: root.can_seek;
                clicked => { root.stop_clicked(); }
            }
            Button {
                text: "⏩";
                width: 44px;
                enabled: root.can_seek;
                clicked => { root.seek_by(5000); }
            }
            Slider {
                minimum: 0;
                maximum: root.duration_ms;
                value: Math.min(root.playhead_ms, root.duration_ms);
                enabled: root.can_seek;
                // Dragging only scrubs the display; the decoders restart at
                // the final position once the knob is released, so video,
                // audio and captions always land on the same timestamp.
                changed(value) => { root.scrub(value); }
                released(value) => { root.seek(value); }
            }
            Text {
                text: root.time_label;
                vertical-alignment: center;
            }
            Button {
                text: root.muted ? "🔇" : "🔊";
                width: 44px;
                clicked => { root.mute_toggled(); }
            }
            Slider {
                minimum: 0;
                maximum: 150;
                value: root.volume;
                width: 120px;
                changed(value) => { root.volume_changed(value); }
            }
            Button {
                text: "⛶";
                width: 44px;
                clicked => { root.fullscreen_toggled(); }
            }
        }
    }
    }
}