// Style inspector: theme presets, typography, colors, and the selected card's
// text.
//
// Every edit is sent to Rust as a whole `ThemeData` snapshot; the Rust side
// validates colors and clamps ranges before it feeds the values back, so this
// component never owns the canonical styling state.

import { FieldLabel, Palette, SectionLabel, ToolButton } from "theme.slint";
import { CheckBox, ComboBox, LineEdit, Slider, ScrollView } from "std-widgets.slint";

export struct ThemeData {
    preset-index: int,
    font-size: int,
    primary-hex: string,
    highlight-hex: string,
    outline-hex: string,
    outline-width: float,
    shadow: float,
    margin-v: int,
    bold: bool,
    uppercase: bool,
    alignment-index: int,
    animation-index: int,
}

export component Inspector inherits Rectangle {
    in property <[string]> preset-names: [];
    in property <[string]> alignment-names: [];
    in property <[string]> animation-names: [];
    in-out property <ThemeData> theme: {
        preset-index: 0,
        font-size: 64,
        primary-hex: "#ffffffff",
        highlight-hex: "#fe2c55ff",
        outline-hex: "#000000ff",
        outline-width: 4.0,
        shadow: 0.0,
        margin-v: 320,
        bold: true,
        uppercase: true,
        alignment-index: 1,
        animation-index: 1
    };
    // Swatches for the hex fields above.
    in property <color> primary-color: white;
    in property <color> highlight-color: #fe2c55;
    in property <color> outline-color: black;
    in property <bool> has-selection: false;
    in-out property <string> caption-text: "";
    in property <string> caption-meta: "";

    callback theme-edited(theme: ThemeData);
    callback caption-edited(text: string);
    callback delete-segment-requested();

    background: Palette.panel;
    border-radius: Palette.radius-lg;
    clip: true;

    ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            SectionLabel { text: "PRESET"; }
            ComboBox {
                model: root.preset-names;
                current-index: root.theme.preset-index;
                selected(value) => {
                    root.theme.preset-index = self.current-index;
                    root.theme-edited(root.theme);
                }
            }

            SectionLabel { text: "TYPE"; }
            HorizontalLayout {
                spacing: 6px;
                FieldLabel { text: "Size"; }
                Slider {
                    horizontal-stretch: 1;
                    minimum: 16;
                    maximum: 160;
                    step: 1;
                    value: root.theme.font-size;
                    changed(value) => {
                        root.theme.font-size = Math.round(value);
                        root.theme-edited(root.theme);
                    }
                }
                Text {
                    text: root.theme.font-size;
                    color: Palette.text;
                    font-size: 12px;
                    width: 30px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                FieldLabel { text: "Outline"; }
                Slider {
                    horizontal-stretch: 1;
                    minimum: 0;
                    maximum: 16;
                    step: 0.5;
                    value: root.theme.outline-width;
                    changed(value) => {
                        root.theme.outline-width = value;
                        root.theme-edited(root.theme);
                    }
                }
                Text {
                    text: root.theme.outline-width;
                    color: Palette.text;
                    font-size: 12px;
                    width: 30px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                FieldLabel { text: "Shadow"; }
                Slider {
                    horizontal-stretch: 1;
                    minimum: 0;
                    maximum: 10;
                    step: 0.5;
                    value: root.theme.shadow;
                    changed(value) => {
                        root.theme.shadow = value;
                        root.theme-edited(root.theme);
                    }
                }
                Text {
                    text: root.theme.shadow;
                    color: Palette.text;
                    font-size: 12px;
                    width: 30px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                FieldLabel { text: "Margin V"; }
                Slider {
                    horizontal-stretch: 1;
                    minimum: 0;
                    maximum: 900;
                    step: 10;
                    value: root.theme.margin-v;
                    changed(value) => {
                        root.theme.margin-v = Math.round(value);
                        root.theme-edited(root.theme);
                    }
                }
                Text {
                    text: root.theme.margin-v;
                    color: Palette.text;
                    font-size: 12px;
                    width: 30px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 12px;
                CheckBox {
                    text: "Bold";
                    checked: root.theme.bold;
                    toggled => {
                        root.theme.bold = self.checked;
                        root.theme-edited(root.theme);
                    }
                }
                CheckBox {
                    text: "Uppercase";
                    checked: root.theme.uppercase;
                    toggled => {
                        root.theme.uppercase = self.checked;
                        root.theme-edited(root.theme);
                    }
                }
            }

            SectionLabel { text: "COLORS"; }
            HorizontalLayout {
                spacing: 6px;
                FieldLabel { text: "Fill"; }
                LineEdit {
                    horizontal-stretch: 1;
                    text: root.theme.primary-hex;
                    edited(text) => {
                        root.theme.primary-hex = text;
                        root.theme-edited(root.theme);
                    }
                }
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Palette.border;
                    background: root.primary-color;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                FieldLabel { text: "Highlight"; }
                LineEdit {
                    horizontal-stretch: 1;
                    text: root.theme.highlight-hex;
                    edited(text) => {
                        root.theme.highlight-hex = text;
                        root.theme-edited(root.theme);
                    }
                }
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Palette.border;
                    background: root.highlight-color;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                FieldLabel { text: "Outline"; }
                LineEdit {
                    horizontal-stretch: 1;
                    text: root.theme.outline-hex;
                    edited(text) => {
                        root.theme.outline-hex = text;
                        root.theme-edited(root.theme);
                    }
                }
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Palette.border;
                    background: root.outline-color;
                }
            }

            SectionLabel { text: "LAYOUT"; }
            HorizontalLayout {
                spacing: 6px;
                FieldLabel { text: "Alignment"; }
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.alignment-names;
                    current-index: root.theme.alignment-index;
                    selected(value) => {
                        root.theme.alignment-index = self.current-index;
                        root.theme-edited(root.theme);
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                FieldLabel { text: "Animation"; }
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.animation-names;
                    current-index: root.theme.animation-index;
                    selected(value) => {
                        root.theme.animation-index = self.current-index;
                        root.theme-edited(root.theme);
                    }
                }
            }

            SectionLabel { text: "CAPTION"; }
            Text {
                text: root.caption-meta;
                color: Palette.text-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            LineEdit {
                enabled: root.has-selection;
                placeholder-text: "No caption selected";
                text: root.caption-text;
                accepted(text) => { root.caption-edited(text); }
                edited(text) => { root.caption-text = text; }
            }
            HorizontalLayout {
                spacing: 6px;
                ToolButton {
                    text: "Apply text";
                    enabled: root.has-selection;
                    clicked => { root.caption-edited(root.caption-text); }
                }
                ToolButton {
                    text: "Delete card";
                    enabled: root.has-selection;
                    clicked => { root.delete-segment-requested(); }
                }
            }
        }
    }
}
