// Main window of the Sublayer caption studio.
//
// The window is a thin composition of the panels; all state lives in Rust and
// flows through these properties and callbacks.

import { Format, Palette } from "theme.slint";
import { Header } from "header.slint";
import { Inspector, ThemeData } from "inspector.slint";
import { BucketItem } from "timeline/waveform.slint";
import { SegmentItem } from "timeline/track.slint";
import { Timeline } from "timeline/timeline.slint";
import { Viewport } from "viewport.slint";

export component MainWindow inherits Window {
    title: "Sublayer — Caption Studio";
    width: 1320px;
    height: 860px;
    background: Palette.bg;

    // Header / project state.
    in property <string> project-name: "Untitled project";
    in-out property <string> video-path: "";
    in property <bool> has-project: false;
    in property <bool> busy: false;
    in property <float> task-progress: 0.0;
    in property <string> status: "Ready";
    in property <[string]> model-names: [];
    in property <int> model-index: 0;
    in property <bool> use-gpu: false;
    in property <bool> use-vad: true;

    // Preview.
    in property <image> preview-frame;
    in property <bool> has-preview: false;
    in property <int> video-width: 0;
    in property <int> video-height: 0;
    in property <string> preview-timecode: "00:00.000";
    in property <string> active-caption: "";
    in property <bool> show-caption: false;

    // Theme mirror.
    in-out property <ThemeData> theme: {
        preset-index: 0,
        font-size: 64,
        primary-hex: "#ffffffff",
        highlight-hex: "#fe2c55ff",
        outline-hex: "#000000ff",
        outline-width: 4.0,
        shadow: 0.0,
        margin-v: 320,
        bold: true,
        uppercase: true,
        alignment-index: 1,
        animation-index: 1
    };
    in property <color> primary-color: white;
    in property <color> highlight-color: #fe2c55;
    in property <color> outline-color: black;
    in property <[string]> preset-names: [];
    in property <[string]> alignment-names: [];
    in property <[string]> animation-names: [];

    // Timeline.
    in property <int> duration-ms: 0;
    in property <int> playhead-ms: 0;
    in property <int> scroll-ms: 0;
    in property <float> pixels-per-second: 50;
    in property <[BucketItem]> buckets: [];
    in property <int> column-base-ms: 0;
    in property <int> column-ms: 100;
    in property <[SegmentItem]> segments: [];
    in property <bool> has-selection: false;
    in-out property <string> caption-text: "";
    in property <string> caption-meta: "";
    // Pixel width of the timeline lane, used for zoom-fit and waveform
    // windowing on the Rust side.
    out property <length> timeline-pixels: timeline-view.lane-pixels;

    // Header intents.
    callback browse-requested();
    callback open-video(path: string);
    callback open-project-requested();
    callback save-requested();
    callback save-as-requested();
    callback export-requested();
    callback transcribe-requested();
    callback settings-changed(model-index: int, use-gpu: bool, use-vad: bool);

    // Timeline intents.
    callback seek(ms: int);
    callback scroll-requested(delta-x: length, delta-y: length, zoom: bool);
    callback zoom-in-requested();
    callback zoom-out-requested();
    callback zoom-fit-requested();
    callback segment-selected(index: int);
    callback segment-drag-begin(index: int, mode: int);
    callback segment-drag-move(index: int, delta-px: length);
    callback segment-drag-end();

    // Inspector intents.
    callback theme-edited(theme: ThemeData);
    callback caption-edited(text: string);
    callback delete-segment-requested();

    VerticalLayout {
        spacing: 0px;

        Header {
            horizontal-stretch: 1;
            project-name: root.project-name;
            video-path <=> root.video-path;
            has-project: root.has-project;
            busy: root.busy;
            task-progress: root.task-progress;
            model-names: root.model-names;
            model-index: root.model-index;
            use-gpu: root.use-gpu;
            use-vad: root.use-vad;
            browse-requested => { root.browse-requested(); }
            open-video(path) => { root.open-video(path); }
            open-project-requested => { root.open-project-requested(); }
            save-requested => { root.save-requested(); }
            save-as-requested => { root.save-as-requested(); }
            export-requested => { root.export-requested(); }
            transcribe-requested => { root.transcribe-requested(); }
            settings-changed(model-index, use-gpu, use-vad) => {
                root.settings-changed(model-index, use-gpu, use-vad);
            }
        }

        content := HorizontalLayout {
            vertical-stretch: 1;
            padding: 10px;
            spacing: 10px;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 10px;

                Viewport {
                    vertical-stretch: 1;
                    min-height: 220px;
                    frame: root.preview-frame;
                    has-frame: root.has-preview;
                    video-width: root.video-width;
                    video-height: root.video-height;
                    caption: root.active-caption;
                    show-caption: root.show-caption;
                    timecode: root.preview-timecode;
                    font-size: root.theme.font-size;
                    primary-color: root.primary-color;
                    outline-color: root.outline-color;
                    outline-width: root.theme.outline-width * 1px;
                    bold: root.theme.bold;
                    uppercase: root.theme.uppercase;
                    margin-v: root.theme.margin-v;
                }

                timeline-view := Timeline {
                    height: 224px;
                    enabled: root.has-project;
                    duration-ms: root.duration-ms;
                    playhead-ms: root.playhead-ms;
                    scroll-ms: root.scroll-ms;
                    pixels-per-second: root.pixels-per-second;
                    buckets: root.buckets;
                    column-base-ms: root.column-base-ms;
                    column-ms: root.column-ms;
                    segments: root.segments;
                    seek(ms) => { root.seek(ms); }
                    scroll-requested(delta-x, delta-y, zoom) => {
                        root.scroll-requested(delta-x, delta-y, zoom);
                    }
                    zoom-in-requested => { root.zoom-in-requested(); }
                    zoom-out-requested => { root.zoom-out-requested(); }
                    zoom-fit-requested => { root.zoom-fit-requested(); }
                    segment-selected(index) => { root.segment-selected(index); }
                    segment-drag-begin(index, mode) => { root.segment-drag-begin(index, mode); }
                    segment-drag-move(index, delta-px) => { root.segment-drag-move(index, delta-px); }
                    segment-drag-end => { root.segment-drag-end(); }
                }
            }

            Inspector {
                width: 322px;
                preset-names: root.preset-names;
                alignment-names: root.alignment-names;
                animation-names: root.animation-names;
                theme <=> root.theme;
                primary-color: root.primary-color;
                highlight-color: root.highlight-color;
                outline-color: root.outline-color;
                has-selection: root.has-selection;
                caption-text <=> root.caption-text;
                caption-meta: root.caption-meta;
                theme-edited(theme) => { root.theme-edited(theme); }
                caption-edited(text) => { root.caption-edited(text); }
                delete-segment-requested => { root.delete-segment-requested(); }
            }
        }

        // Status bar.
        Rectangle {
            height: 26px;
            background: Palette.panel;

            // Top hairline separator (per-side borders are not supported).
            Rectangle {
                y: 0;
                width: parent.width;
                height: 1px;
                background: Palette.border;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                Text {
                    text: root.status;
                    color: Palette.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: root.has-project
                        ? "Cards " + root.segments.length + " · Wheel pans · Ctrl+Wheel zooms · Drag cards to retime"
                        : "";
                    color: Palette.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.has-project ? "Playhead " + Format.timecode(root.playhead-ms) : "";
                    color: Palette.text;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
