// Caption cards lane.
//
// Blocks are positioned from the segment model. The body drags the whole card,
// the edge handles trim its start/end; the Rust side owns the timing math and
// clamps the result, so the UI only reports pointer deltas.

import { Format, Palette, ToolButton } from "../theme.slint";

export struct SegmentItem {
    index: int,
    start-ms: int,
    end-ms: int,
    text: string,
    selected: bool,
}

export component Track inherits Rectangle {
    in property <[SegmentItem]> segments: [];
    in property <int> scroll-ms: 0;
    in property <float> pixels-per-second: 50;
    in property <bool> enabled: true;

    callback seeked(ms: int);
    callback wheeled(delta-x: length, delta-y: length, zoom: bool);
    callback select(index: int);
    // The right-click menu asks for a manually inserted caption card.
    callback add-caption(ms: int);
    // `mode`: 0 = move, 1 = trim start, 2 = trim end. `pointer-x` is the
    // pointer's window position: the card follows it, so an item-relative
    // reading would shrink every gesture by half.
    callback drag-begin(index: int, mode: int, pointer-x: length);
    callback drag-move(pointer-x: length);
    callback drag-end();

    background: Palette.panel;
    clip: true;

    property <length> px-per-ms: root.pixels-per-second / 1000 * 1px;

    // Right-click context menu state (pointer position in the lane).
    in-out property <bool> menu-visible: false;
    property <int> menu-ms: 0;
    property <length> menu-x: 0px;
    property <length> menu-y: 0px;

    // Clicking the empty lane moves the playhead; a right click instead offers
    // to insert a caption card at that time. Blocks are declared after this
    // area and therefore sit on top of it.
    lane-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: crosshair;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.menu-visible = false;
                if (event.button == PointerEventButton.right) {
                    root.menu-ms = Math.round(root.scroll-ms + self.mouse-x / root.px-per-ms);
                    root.menu-x = self.mouse-x;
                    root.menu-y = self.mouse-y;
                    root.menu-visible = true;
                } else {
                    root.seeked(Math.round(root.scroll-ms + self.mouse-x / root.px-per-ms));
                }
            }
        }
        scroll-event(event) => {
            root.wheeled(event.delta-x, event.delta-y, event.modifiers.control);
            return accept;
        }
    }

    for segment[i] in root.segments : caption-block := Rectangle {
        x: (segment.start-ms - root.scroll-ms) * root.px-per-ms;
        y: 5px;
        width: max(12px, (segment.end-ms - segment.start-ms) * root.px-per-ms);
        height: parent.height - 10px;
        border-radius: Palette.radius;
        background: segment.selected ? Palette.selection : Palette.panel-alt;
        border-width: 1px;
        border-color: segment.selected ? Palette.accent : Palette.border;

        Text {
            text: segment.text;
            color: Palette.text;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
            x: 8px;
            width: max(0px, parent.width - 16px);
            height: parent.height;
        }

        TouchArea {
            x: 6px;
            width: max(0px, parent.width - 12px);
            height: parent.height;
            mouse-cursor: move;
            moved => { root.drag-move(self.absolute-position.x + self.mouse-x); }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.menu-visible = false;
                    if (event.button == PointerEventButton.left) {
                        root.select(segment.index);
                        root.drag-begin(segment.index, 0, self.absolute-position.x + self.mouse-x);
                    }
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.drag-end();
                }
            }
            scroll-event(event) => {
                root.wheeled(event.delta-x, event.delta-y, event.modifiers.control);
                return accept;
            }
        }

        TouchArea {
            x: 0;
            width: 6px;
            height: parent.height;
            mouse-cursor: col-resize;
            moved => { root.drag-move(self.absolute-position.x + self.mouse-x); }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.menu-visible = false;
                    if (event.button == PointerEventButton.left) {
                        root.select(segment.index);
                        root.drag-begin(segment.index, 1, self.absolute-position.x + self.mouse-x);
                    }
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.drag-end();
                }
            }
        }

        TouchArea {
            x: parent.width - 6px;
            width: 6px;
            height: parent.height;
            mouse-cursor: col-resize;
            moved => { root.drag-move(self.absolute-position.x + self.mouse-x); }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.menu-visible = false;
                    if (event.button == PointerEventButton.left) {
                        root.select(segment.index);
                        root.drag-begin(segment.index, 2, self.absolute-position.x + self.mouse-x);
                    }
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.drag-end();
                }
            }
        }
    }

    // Right-click menu: use it to insert a caption whisper missed. It is the
    // last child, so it renders above the cards and the lane.
    context-menu := Rectangle {
        visible: root.menu-visible;
        x: min(root.menu-x, parent.width - 224px);
        y: min(root.menu-y, parent.height - 76px);
        width: 224px;
        height: 76px;
        background: Palette.raised;
        border-radius: Palette.radius;
        border-width: 1px;
        border-color: Palette.border;

        VerticalLayout {
            padding: 8px;
            spacing: 4px;

            Text {
                text: "Whisper missed this? Add it manually.";
                color: Palette.text-dim;
                font-size: 11px;
                overflow: elide;
            }
            add-caption-button := ToolButton {
                text: "Add caption @ " + Format.timecode(root.menu-ms);
                filled: true;
                clicked => {
                    root.add-caption(root.menu-ms);
                    root.menu-visible = false;
                }
            }
        }
    }
}
