// Right-side captions drawer: every caption card as a timestamped row with an
// editable text field, like the captions sidebar of a video platform.
//
// Rows are plain data (`CaptionRow`); the Rust side refreshes them from the
// project on any segment change, so edits here and the timeline stay in sync.
// The drawer slides in as an overlay, covering the inspector while open.

import { Palette, ToolButton } from "theme.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";

export struct CaptionRow {
    index: int,
    label: string,
    text: string,
    selected: bool,
}

component CaptionRowView inherits Rectangle {
    in property <CaptionRow> item;

    callback selected(index: int);
    callback edited(index: int, text: string);

    height: 52px;
    border-radius: Palette.radius;
    background: item.selected ? Palette.accent-soft : Palette.panel-alt;
    border-width: 1px;
    border-color: item.selected ? Palette.accent : Palette.border;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;

        // The timestamp strip selects and seeks the card; the text field
        // handles its own input.
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.selected(root.item.index); }
            Text {
                text: item.label;
                color: item.selected ? Palette.accent : Palette.text-dim;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                width: 130px;
            }
        }

        LineEdit {
            vertical-stretch: 1;
            height: 24px;
            font-size: 13px;
            text: item.text;
            accepted(text) => { root.edited(root.item.index, text); }
            edited(text) => { root.edited(root.item.index, text); }
        }
    }
}

export component CaptionsDrawer inherits Rectangle {
    in property <bool> open: false;
    in property <[CaptionRow]> rows: [];
    // Width of the host window, so the drawer can slide past its right edge.
    in property <length> host-width: 0px;
    // Height of the host window.
    in property <length> host-height: 0px;

    callback close-requested();
    callback row-selected(index: int);
    callback row-edited(index: int, text: string);

    width: 340px;
    height: root.host-height;
    background: Palette.panel;
    x: root.open ? root.host-width - root.width : root.host-width;
    animate x { duration: 180ms; easing: ease-out; }

    // Left hairline separator (per-side borders are not supported).
    Rectangle {
        x: 0;
        width: 1px;
        height: parent.height;
        background: Palette.border;
    }

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: "Captions";
                color: Palette.text;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: root.rows.length == 1 ? "1 card" : root.rows.length + " cards";
                color: Palette.text-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            ToolButton {
                text: "Hide";
                clicked => { root.close-requested(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }

        if root.rows.length == 0: VerticalLayout {
            spacing: 6px;
            Text {
                text: "No caption cards";
                color: Palette.text;
                font-size: 13px;
                font-weight: 600;
            }
            Text {
                text: "Transcribe the video to create cards.";
                color: Palette.text-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                for caption in root.rows : cap-row := CaptionRowView {
                    item: caption;
                    selected(index) => { root.row-selected(index); }
                    edited(index, text) => { root.row-edited(index, text); }
                }
            }
        }
    }
}